{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/reserve", "destination": "/reserve.html" },
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/card-viewer", "destination": "/card-viewer.html" }
  ]
}
